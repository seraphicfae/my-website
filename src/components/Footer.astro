---
import { Icon } from "astro-icon/components";
---

<footer class="mt-auto flex justify-center px-6 py-6">
	<div
		class="flex items-center gap-6 rounded-full border border-border/70 bg-background/80 px-6 py-3 text-sm shadow-lg backdrop-blur-xl text-secondary"
	>
		<a
			href="https://www.oracle.com/erp/"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="heart"
			class="flex items-center justify-center gap-2"
		>
			Psst, you're cute
			<Icon name="lucide:heart" class="text-accent-secondary" />
		</a>

		<span class="h-3 w-px bg-divider"></span>

		<a
			href="https://github.com/seraphicfae/seraphicfae.dev"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="GitHub"
			class="transition-colors hover:text-foreground"
		>
			<Icon name="simple-icons:github" class="h-4 w-4" />
		</a>
	</div>
</footer>
