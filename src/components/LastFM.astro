---
import { Icon } from "astro-icon/components";
import {
	LASTFM_USERNAME,
	fetchRecentTracks,
	type LastFmTrack,
} from "../lib/lastfm";

let tracks: LastFmTrack[] = [];
try {
	tracks = await fetchRecentTracks();
} catch (e) {
	console.error("Failed fetching Last.fm at build time:", e);
}
---

<section class="flex flex-col gap-4">
	<div class="flex items-center gap-2">
		<Icon name="simple-icons:lastdotfm" class="size-4 shrink-0" />
		<h2 class="font-black tracking-widest uppercase">last.fm</h2>
	</div>

	<ul
		id="lastfm-tracks"
		class="flex flex-col"
		data-initial={JSON.stringify(tracks)}
	>
		{
			tracks.length === 0 && (
				<li class="text-muted py-2.5 text-sm">Nothing to see here</li>
			)
		}
	</ul>
	<a
		href={`https://last.fm/${LASTFM_USERNAME}`}
		target="_blank"
		rel="noopener noreferrer"
		class="group flex items-center justify-center gap-2 text-xs font-bold tracking-widest uppercase opacity-60 transition-opacity hover:opacity-100"
	>
		<img
			src="https://lastfm-img.freetls.fastly.net/i/u/avatar170s/1c770caa288ee3c1eca3b542e8c93639.png"
			alt={LASTFM_USERNAME}
			width={20}
			height={20}
			loading="lazy"
			decoding="async"
			class="size-5 shrink-0 rounded-full object-cover"
		/>
		view more on Last.FM
		<Icon
			name="lucide:arrow-up-right"
			class="size-3.5 transition-transform group-hover:rotate-45"
		/>
	</a>
</section>

<script>
	import {
		getImageUrl,
		formatTime,
		isNowPlaying,
		fetchRecentTracks,
		type LastFmTrack,
	} from "../lib/lastfm";

	function renderTrack(track: LastFmTrack): string {
		const nowPlaying = isNowPlaying(track);
		const art = getImageUrl(track);
		const meta = nowPlaying
			? `<span class="font-bold">now playing</span>`
			: track.date
				? formatTime(track.date.uts)
				: "";

		return `
			<li>
				<a href="${track.url}" target="_blank" rel="noopener noreferrer"
				   class="group -mx-2 flex items-center gap-3 rounded-lg px-2 py-2.5 transition-colors hover:bg-surface-hover ${nowPlaying ? "bg-accent-secondary/10 hover:bg-accent-secondary/10" : ""}">
					<span class="size-12 shrink-0 overflow-hidden rounded-lg bg-surface">
						${art ? `<img src="${art}" alt="" loading="lazy" decoding="async" class="size-full object-cover" />` : ""}
					</span>
					<span class="min-w-0 flex-1">
						<span class="block truncate text-sm font-semibold group-hover:underline">${track.name}</span>
						<span class="block truncate text-sm text-muted">
							${track.artist?.["#text"] ?? "Unknown Artist"} &middot; <span>${meta}</span>
						</span>
					</span>
				</a>
			</li>
		`;
	}

	async function refresh(listEl: HTMLElement) {
		try {
			const tracks = await fetchRecentTracks();
			if (!tracks.length) return;
			listEl.innerHTML = tracks.map(renderTrack).join("");
		} catch (e) {
			console.error("Failed fetching from Last.fm", e);
		}
	}

	function init() {
		const listEl = document.getElementById("lastfm-tracks");
		if (!listEl) return;

		const serverTracks: LastFmTrack[] = JSON.parse(
			listEl.dataset.initial || "[]",
		);
		if (serverTracks.length) {
			listEl.innerHTML = serverTracks.map(renderTrack).join("");
		}
		refresh(listEl);
	}

	init();
	document.addEventListener("astro:page-load", init);
</script>
